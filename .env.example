# Configurações de ambiente — copie para .env e ajuste conforme necessário.

# URI do servidor de tracking do MLflow.
# Vazio = tracking local em ./mlruns (sem Model Registry).
# Local com registry: http://localhost:5000 | Docker Compose: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Caminho do remote local do DVC (fora do repositório), usado como fallback
# offline do remote principal no Google Drive. Ver README > Versionamento.
DVC_REMOTE_PATH=

# Seed global para reprodutibilidade.
# Observação: no pipeline DVC, params.yaml tem precedência sobre esta variável;
# ela permanece como fallback para execuções fora do `dvc repro`.
SEED=42
